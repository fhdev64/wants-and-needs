{
  "name": "wants-and-needs",
  "productName": "Хотелки",
  "version": "1.0.0",
  "description": "Мои хотелки",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "app.wants.needs",
    "productName": "Hotelki",
    "files": [
      "main.js",
      "preload.js",
      "server/src/shops-core.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Hotelki.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "hotelki": {
    "server": "http://localhost:8787"
  }
}
