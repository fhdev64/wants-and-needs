{
  "name": "wants-and-needs",
  "productName": "хотелкино ✦︎",
  "version": "1.0.0",
  "description": "хотелкино ✦︎ — список желаний и лучшие цены",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "app.wants.needs",
    "productName": "hotelkino",
    "files": [
      "main.js",
      "preload.js",
      "server/src/shops-core.js",
      "src/**/*",
      "assets/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "hotelkino.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "hotelki": {
    "server": "http://188.120.246.113:8787"
  }
}